# Grow Trading configuration. Copy to .env and fill in. .env is git-ignored.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=groww_trading

# Hard cap on lots for LIVE (real-money) trading
LIVE_MAX_LOTS=1

# Groww credentials (optional here). If GROWW_API_KEY is empty, keys.txt in the project root is used.
# GROWW_API_KEY is the TOTP token; GROWW_TOTP_SECRET is the code shown with its QR.
# For an approval-type key use GROWW_API_SECRET instead of GROWW_TOTP_SECRET.
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GROWW_API_SECRET=
